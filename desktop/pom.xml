<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.olivelli.fxcenter</groupId>
    <artifactId>fx-center-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>

  <artifactId>fx-center-desktop</artifactId>
  <name>FX Center :: desktop</name>
  <description>Swing desktop application, shipped as one runnable jar.</description>

  <dependencies>
    <dependency>
      <groupId>dev.olivelli.fxcenter</groupId>
      <artifactId>fx-center-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- MP3 decoding for javax.sound.sampled: registers itself as a service
         provider, so AudioSystem.getAudioInputStream reads MP3 as it reads
         WAV. Pure Java (JLayer underneath), LGPL-2.1, ~300 KB. -->
    <dependency>
      <groupId>com.googlecode.soundlibs</groupId>
      <artifactId>mp3spi</artifactId>
      <version>1.9.5.4</version>
      <exclusions>
        <!-- jlayer declares junit 3 at compile scope; keep it out of the jar. -->
        <exclusion>
          <groupId>junit</groupId>
          <artifactId>junit</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <finalName>fx-center-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <!-- Merges META-INF/services, which is how mp3spi plugs into
                     javax.sound; without it the shaded jar plays WAV only. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>dev.olivelli.fxcenter.desktop.FxCenterApp</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
