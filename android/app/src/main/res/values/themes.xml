<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The platform's dark theme, no AppCompat, no Material library: the
         screen is a list and three buttons. No action bar; the top row of the
         layout is the toolbar. Dialogs follow it, so they are dark too. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>

    <style name="AppDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/raised</item>
        <item name="android:textColorPrimary">@color/text</item>
    </style>

    <!-- The small buttons of the top row: quiet. -->
    <style name="ToolButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>

    <!-- GO / PAUSA / STOP: deep fills, so three big buttons do not glow. -->
    <style name="Transport" parent="@android:style/Widget.Material.Button">
        <item name="android:textColor">@color/transport_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
